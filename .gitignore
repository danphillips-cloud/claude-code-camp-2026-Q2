# Windows Zone.Identifier files (WSL download metadata)
*:Zone.Identifier

node_modules/
__pycache__/
.venv/
venv/
*.pyc
.env
.env.local
.DS_Store
.vscode/
.claude/settings.local.json
/CLAUDE.md
CLAUDE.local.md
/research.md
/plan.md
.my-notes/
*.gem

# .boukensha/ is a marker directory — real config/sessions land in the
# user's actual ~/.boukensha, never here. Keep only the marker file.
/.boukensha/*
!/.boukensha/.keep

# Steps' examples/example.rb default BOUKENSHA_DIR to a repo-relative
# .boukensha/ if unset (see week1_baseline/.my-notes/2026-08-16_LIVE_SESSION_SUMMARY.md) —
# the root rule above only anchors to /, so nested copies need their own rule.
week1_baseline/.boukensha/

# Generated output from bin/convert-world (parsed CircleMUD world JSON)
docs/explore_architectures.md
week0_explore/preview/data/world/*/
!week0_explore/preview/data/world/.keep